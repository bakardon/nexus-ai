# Hosted model providers (optional; direct chat endpoint only)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Provider/model configuration
NEXUS_DEFAULT_PROVIDER=ollama
NEXUS_DEFAULT_MODEL=llama3.2

# Local Ollama endpoint
NEXUS_OLLAMA_BASE_URL=http://localhost:11434

# NEXUS API
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000
